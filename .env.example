# Site URL used by metadata, canonical URLs, RSS, sitemap, robots, share links, and OG images.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend API key for server-side route handlers.
# Do not prefix secrets with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend Audience ID used by /api/subscribe.
RESEND_AUDIENCE_ID=aud_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address used by /api/contact.
FORMS_FROM_EMAIL="LunaPath Blog <onboarding@resend.dev>"

# Destination inbox for contact form messages.
CONTACT_TO_EMAIL=you@example.com

# Optional comma-separated allowed origins for form submissions.
# Example: https://your-domain.com,http://localhost:3000
FORM_ALLOWED_ORIGINS=

# Optional Umami analytics script.
# These values are public because the browser needs them to load the analytics script.
NEXT_PUBLIC_UMAMI_ENABLED=true
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Giscus comment system IDs.
# These are public because Giscus runs in the browser.
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Optional private admin dashboard at /admin.
# Requests fail closed if either value is missing.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional shortcut shown on the private admin dashboard.
UMAMI_DASHBOARD_URL=https://cloud.umami.is
